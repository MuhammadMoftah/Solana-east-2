---
interface Props {
  name: keyof typeof paths;
  class?: string;
  label?: string;
}

const paths = {
  arrow: 'M4 12h15M13 6l6 6-6 6',
  'arrow-left': 'M20 12H5M11 6l-6 6 6 6',
  plus: 'M12 5v14M5 12h14',
  menu: 'M4 8h16M8 16h12',
  close: 'M6 6l12 12M18 6L6 18',
  pin: 'M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0113 0c0 4.8-6.5 11-6.5 11zM12 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z',
  road: 'M8 3L5 21M16 3l3 18M12 4v3M12 10.5v3M12 17v3',
  phone: 'M5 4h3.5l1.5 4.5-2 1.5a11 11 0 006 6l1.5-2 4.5 1.5V19a2 2 0 01-2 2C10.6 21 3 13.4 3 6a2 2 0 012-2z',
  external: 'M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5',
  chevron: 'M6 9l6 6 6-6',
} as const;

const { name, class: className = 'size-5', label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <path d={paths[name]} />
</svg>
