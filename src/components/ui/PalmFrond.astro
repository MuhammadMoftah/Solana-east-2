---
/**
 * Decorative palm frond, generated at build time as a single SVG path
 * (rachis + tapered leaflets). Rendered in `currentColor`.
 */
interface Props {
  class?: string;
  leaflets?: number;
  style?: string;
}

const { class: className, leaflets = 30, style } = Astro.props;

const P0 = [24, 392];
const C = [130, 150];
const P2 = [392, 34];
const r = (n: number) => Math.round(n * 10) / 10;

const at = (t: number) => [
  (1 - t) ** 2 * P0[0] + 2 * (1 - t) * t * C[0] + t ** 2 * P2[0],
  (1 - t) ** 2 * P0[1] + 2 * (1 - t) * t * C[1] + t ** 2 * P2[1],
];
const tangent = (t: number) => {
  const dx = 2 * (1 - t) * (C[0] - P0[0]) + 2 * t * (P2[0] - C[0]);
  const dy = 2 * (1 - t) * (C[1] - P0[1]) + 2 * t * (P2[1] - C[1]);
  const len = Math.hypot(dx, dy);
  return [dx / len, dy / len];
};
const rotate = ([x, y]: number[], deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [x * Math.cos(a) - y * Math.sin(a), x * Math.sin(a) + y * Math.cos(a)];
};

let d = '';
for (let i = 0; i < leaflets; i++) {
  const t = 0.12 + (i / (leaflets - 1)) * 0.86;
  const p = at(t);
  const tan = tangent(t);
  const length = 30 + 150 * Math.sin(Math.PI * Math.min(1, t * 1.05)) * (1 - t * 0.35);
  for (const side of [-1, 1]) {
    const dir = rotate(tan, side * (62 - 34 * t));
    const droop = side === 1 ? 0.22 : 0.08;
    const end = [p[0] + dir[0] * length, p[1] + dir[1] * length + length * droop];
    const mid = [(p[0] + end[0]) / 2, (p[1] + end[1]) / 2];
    const n = [-dir[1], dir[0]];
    const w = length * 0.075;
    d += `M${r(p[0])} ${r(p[1])}Q${r(mid[0] + n[0] * w)} ${r(mid[1] + n[1] * w)} ${r(end[0])} ${r(end[1])}Q${r(mid[0] - n[0] * w)} ${r(mid[1] - n[1] * w)} ${r(p[0])} ${r(p[1])}Z`;
  }
}
---

<svg class={className} style={style} viewBox="0 0 520 520" fill="none" aria-hidden="true" focusable="false">
  <path d={`M${P0[0]} ${P0[1]}Q${C[0]} ${C[1]} ${P2[0]} ${P2[1]}`} stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  <path d={d} fill="currentColor" />
</svg>
