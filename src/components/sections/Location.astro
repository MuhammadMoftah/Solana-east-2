---
import Icon from '../ui/Icon.astro';
import { content, getSection, sourceList } from '../../lib/content.js';

const section = getSection('location');
const { location } = content.project;

// Sources disagree on AUC (guide/brochure ≈15 min, Property Finder 10 min), so show the quoted range.
const quotedRanges: Record<string, { time: string; extraSourceIds: string[] }> = {
  'American University in Cairo (AUC)': { time: '10–15', extraSourceIds: ['property-finder'] },
};
// The source groups two destinations together; excluded until clarified (see content note).
const excluded = new Set(['Ring Road / CFC']);

const places = section.content.nearbyPlaces
  .filter((place: any) => !excluded.has(place.name))
  .map((place: any) => {
    const range = quotedRanges[place.name];
    return {
      ...place,
      time: range?.time ?? `${place.travelTimeMinutes}`,
      sourceIds: [...place.sourceIds, ...(range?.extraSourceIds ?? [])],
    };
  })
  .sort((a: any, b: any) => a.travelTimeMinutes - b.travelTimeMinutes);
---

<section id="location" class="section section-tint overflow-hidden" aria-labelledby="location-title">
  <div class="pointer-events-none absolute top-1/2 -left-[18rem] hidden size-[40rem] -translate-y-1/2 lg:block" aria-hidden="true">
    <span class="absolute inset-0 rounded-full border border-champagne-300/10"></span>
    <span class="absolute inset-[5rem] rounded-full border border-champagne-300/10"></span>
    <span class="absolute inset-[10rem] rounded-full border border-champagne-300/[0.12]"></span>
    <span class="absolute inset-[15rem] rounded-full border border-champagne-300/15"></span>
  </div>

  <div class="container-x relative grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <p class="eyebrow" data-reveal>{section.title}</p>
      <h2 id="location-title" class="heading-2 mt-6" data-reveal style="--reveal-delay:80">
        {section.content.heading}
        <span class="italic-accent mt-4 block">{location.district}, {location.city}</span>
      </h2>
      <p class="lead mt-8" data-reveal style="--reveal-delay:140">
        Solana East is located in {location.district}, {location.city} — part of {location.broaderArea}, with access to {
          location.nearbyRoads.slice(0, -1).join(', ')
        } and the {location.nearbyRoads.at(-1)}.
      </p>
      <ul class="mt-10 space-y-3" data-reveal style="--reveal-delay:180">
        <li class="flex items-center gap-3 text-champagne-100">
          <Icon name="pin" class="size-5 text-champagne-500" />
          {location.district}, {location.city}, {location.country}
        </li>
        {
          location.nearbyRoads.map((road: string) => (
            <li class="flex items-center gap-3 text-mist-300">
              <Icon name="road" class="size-5 text-champagne-500" />
              {road}
            </li>
          ))
        }
      </ul>
      <p class="source-note mt-6" data-reveal>Road access as listed by {sourceList(['property-finder'])}.</p>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <ol class="hairline border-t">
        {
          places.map((place: any, index: number) => (
            <li class="hairline grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 border-b py-6" data-reveal style={`--reveal-delay:${index * 70}`}>
              <span class="font-display text-[clamp(1.375rem,1.1rem+0.9vw,1.875rem)] leading-tight text-champagne-100">{place.name}</span>
              <span class="text-right whitespace-nowrap">
                <span class="font-display text-[clamp(2rem,1.6rem+1.4vw,2.875rem)] leading-none text-champagne-300">≈{place.time}</span>
                <span class="ml-1 text-[0.6875rem] font-semibold tracking-[0.14em] text-champagne-500 uppercase">min</span>
              </span>
              <span class="meta col-span-2 text-xs">Quoted by {sourceList(place.sourceIds)}</span>
            </li>
          ))
        }
      </ol>
      <p class="source-note mt-6" data-reveal>
        Approximate drive times as quoted by the sources above. Actual journeys depend on route, starting point and
        traffic. Exact site coordinates have not been published; ask the sales team for the location.
      </p>
    </div>
  </div>
</section>
