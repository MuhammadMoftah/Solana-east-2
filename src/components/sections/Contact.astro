---
import InquiryForm from '../contact/InquiryForm.vue';
import PalmFrond from '../ui/PalmFrond.astro';
import Icon from '../ui/Icon.astro';
import { content, getSection, sourceList, digitsOnly } from '../../lib/content.js';

const section = getSection('contact');
const units = getSection('residential-units');
const { thirdPartyContact } = section.content;
const phoneDigits = digitsOnly(thirdPartyContact.phone);
const unitTypes = units.content.unitTypes.map((unit: any) => unit.name);
---

<section id="contact" class="section overflow-hidden" aria-labelledby="contact-title">
  <PalmFrond class="decor-frond -bottom-24 -left-28 w-[24rem] rotate-[-8deg] sm:w-[30rem]" />
  <PalmFrond class="decor-frond -top-10 -right-36 w-[30rem] rotate-[160deg] max-md:hidden" />

  <div class="container-x relative">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{section.title}</p>
        <h2 id="contact-title" class="heading-2 mt-6" data-reveal style="--reveal-delay:80">
          {section.content.heading}
        </h2>
        <p class="lead mt-7" data-reveal style="--reveal-delay:140">{section.content.description}</p>
      </div>
      <div class="lg:col-span-5 lg:justify-self-end" data-reveal style="--reveal-delay:180">
        <p class="label">Call or WhatsApp</p>
        <a href={`tel:+${phoneDigits}`} class="mt-3 inline-flex items-center gap-3 font-display text-[clamp(1.75rem,1.4rem+1.2vw,2.5rem)] leading-none text-champagne-300 transition-colors hover:text-champagne-50">
          <Icon name="phone" class="size-6 text-champagne-500" />
          {thirdPartyContact.phone}
        </a>
        <p class="source-note mt-3 max-w-xs">
          Published by the {sourceList(thirdPartyContact.sourceIds)} — not verified as an official ORA sales channel.
        </p>
      </div>
    </div>

    <div class="mt-16 rounded-[2rem] border border-champagne-300/20 bg-night-900/70 p-6 backdrop-blur-sm sm:p-10 lg:mt-20 lg:rounded-[2.75rem] lg:p-14" data-reveal="fade">
      <InquiryForm
        client:visible
        fields={section.content.formFields}
        unitTypes={unitTypes}
        whatsappNumber={phoneDigits}
        projectName={content.project.displayName}
        disclaimer={section.content.disclaimer}
      />
      <noscript>
        <p class="text-mist-200">
          The enquiry form needs JavaScript. You can call
          <a class="text-link" href={`tel:+${phoneDigits}`}>{thirdPartyContact.phone}</a> or message on
          <a class="text-link" href={`https://wa.me/${phoneDigits}`}>WhatsApp</a>.
        </p>
      </noscript>
    </div>
  </div>
</section>
